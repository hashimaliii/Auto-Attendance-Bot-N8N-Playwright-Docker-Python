        "jsCode": "// Safely look for the text in the different places WhatsApp might put it\nconst text = $input.item.json.body?.data?.message?.extendedTextMessage?.text \n          || $input.item.json.body?.data?.message?.conversation \n          || \"\";\n\n// Use Regex to find the Google Meet link\nconst meetLinkMatch = text.match(/https:\\/\\/meet\\.google\\.com\\/[a-z0-9-]+/i);\n\n// If a link is found, pass it to the next step. If not, stop the workflow.\nif (meetLinkMatch) {\n    return { url: meetLinkMatch[0] };\n} else {\n    return []; // Stops execution (ignores random chatter)\n}"
