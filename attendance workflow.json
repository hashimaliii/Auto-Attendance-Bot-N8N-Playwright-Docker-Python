      "webhookId": "1abbf8eb-ade5-4c72-919f-e119c34df6b3"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\n// Detect source: WhatsApp has body.event = \"messages.upsert\"\nconst isWhatsApp = data.body?.event === \"messages.upsert\";\n\n// Settings\nconst allowedClasses = (data.allowed_classes || \"\")\n  .split(',')\n  .map(item => item.trim().toLowerCase())\n  .filter(Boolean);\nconst targetPhone = data.whatsapp_number || \"\";\n\n// If WhatsApp → skip class matching, always allow\nif (isWhatsApp) {\n  const conversation = data.body?.data?.message?.conversation\n    || data.body?.data?.message?.extendedTextMessage?.text\n    || \"\";\n\n  const meetUrlMatch = conversation.match(/https?:\\/\\/meet\\.google\\.com\\/[a-z0-9-]+/gi);\n  const meetUrl = meetUrlMatch ? meetUrlMatch[0] : null;\n\n  return [{\n    json: {\n      isAllowed:    true,\n      matchedClass: \"whatsapp\",\n      targetNumber: targetPhone,\n      meetUrl:      meetUrl\n    }\n  }];\n}\n\n// Email path — raw content may be in text, html, or textHtml\nconst rawContent = data.textHtml || data.html || data.text || data.subject || \"\";\n\n// Step 1: Extract Meet URL from raw HTML BEFORE stripping tags\n// (URLs are often inside <a href=\"...\"> and would be lost after stripping)\nconst meetUrlMatch = rawContent.match(/https?:\\/\\/meet\\.google\\.com\\/[a-z0-9-]+/gi);\nconst meetUrl = meetUrlMatch ? meetUrlMatch[0] : null;\n\n// Step 2: Strip HTML tags to get plain text for class name matching\nconst plainText = rawContent\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .toLowerCase();\n\n// Step 3: Decode HTML entities\nconst decoded = plainText\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#[0-9]+;/g, ' ');\n\n// Step 4: Match class — if allowed_classes is empty, allow all\nlet matchedClass;\nif (allowedClasses.length === 0) {\n  // No filter configured → allow everything\n  matchedClass = \"any\";\n} else {\n  matchedClass = allowedClasses.find(cls => decoded.includes(cls));\n}\n\nreturn [{\n  json: {\n    isAllowed:    !!(matchedClass && meetUrl),\n    matchedClass: matchedClass || \"None\",\n    targetNumber: targetPhone,\n    meetUrl:      meetUrl\n  }\n}];"
      },
